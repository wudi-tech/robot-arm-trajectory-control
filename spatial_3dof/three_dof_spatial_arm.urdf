<?xml version="1.0"?>
<robot name="three_dof_spatial_arm">
  <link name="base">
    <visual>
      <origin xyz="0 0 0.175" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.18" length="0.35"/>
      </geometry>
      <material name="base_gray">
        <color rgba="0.25 0.25 0.25 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.175" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.18" length="0.35"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.175" rpy="0 0 0"/>
      <mass value="3.0"/>
      <inertia ixx="0.0548" ixy="0" ixz="0" iyy="0.0548" iyz="0" izz="0.0486"/>
    </inertial>
  </link>

  <link name="yaw_hub">
    <visual>
      <origin xyz="0 0 0" rpy="1.5707963268 0 0"/>
      <geometry>
        <cylinder radius="0.12" length="0.18"/>
      </geometry>
      <material name="hub_dark">
        <color rgba="0.08 0.08 0.08 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5707963268 0 0"/>
      <geometry>
        <cylinder radius="0.12" length="0.18"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.8"/>
      <inertia ixx="0.0046" ixy="0" ixz="0" iyy="0.0046" iyz="0" izz="0.0068"/>
    </inertial>
  </link>

  <link name="upper_arm">
    <visual>
      <origin xyz="0.425 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.85 0.10 0.10"/>
      </geometry>
      <material name="upper_blue">
        <color rgba="0.1 0.35 0.95 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0.425 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.85 0.10 0.10"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0.425 0 0" rpy="0 0 0"/>
      <mass value="1.2"/>
      <inertia ixx="0.0020" ixy="0" ixz="0" iyy="0.0733" iyz="0" izz="0.0733"/>
    </inertial>
  </link>

  <link name="forearm">
    <visual>
      <origin xyz="0.325 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.65 0.09 0.09"/>
      </geometry>
      <material name="forearm_orange">
        <color rgba="0.95 0.42 0.05 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0.325 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.65 0.09 0.09"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0.325 0 0" rpy="0 0 0"/>
      <mass value="0.8"/>
      <inertia ixx="0.0011" ixy="0" ixz="0" iyy="0.0287" iyz="0" izz="0.0287"/>
    </inertial>
  </link>

  <link name="end_effector">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.07"/>
      </geometry>
      <material name="ee_red">
        <color rgba="0.9 0.05 0.05 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.07"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.2"/>
      <inertia ixx="0.0004" ixy="0" ixz="0" iyy="0.0004" iyz="0" izz="0.0004"/>
    </inertial>
  </link>

  <joint name="joint1_base_yaw" type="revolute">
    <parent link="base"/>
    <child link="yaw_hub"/>
    <origin xyz="0 0 0.35" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14159" upper="3.14159" effort="30" velocity="4"/>
    <dynamics damping="0.04" friction="0.01"/>
  </joint>

  <joint name="joint2_shoulder_pitch" type="revolute">
    <parent link="yaw_hub"/>
    <child link="upper_arm"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 -1 0"/>
    <limit lower="-1.5708" upper="1.5708" effort="30" velocity="4"/>
    <dynamics damping="0.05" friction="0.015"/>
  </joint>

  <joint name="joint3_elbow_pitch" type="revolute">
    <parent link="upper_arm"/>
    <child link="forearm"/>
    <origin xyz="0.85 0 0" rpy="0 0 0"/>
    <axis xyz="0 -1 0"/>
    <limit lower="-2.8" upper="2.8" effort="25" velocity="4"/>
    <dynamics damping="0.04" friction="0.012"/>
  </joint>

  <joint name="ee_fixed" type="fixed">
    <parent link="forearm"/>
    <child link="end_effector"/>
    <origin xyz="0.65 0 0" rpy="0 0 0"/>
  </joint>
</robot>
