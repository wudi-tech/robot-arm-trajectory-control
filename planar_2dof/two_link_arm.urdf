<?xml version="1.0"?>
<robot name="two_link_planar_arm">
  <link name="base">
    <visual>
      <origin xyz="0 0 0.18" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.16" length="0.36"/>
      </geometry>
      <material name="base_gray">
        <color rgba="0.25 0.25 0.25 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.18" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.16" length="0.36"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
    </inertial>
  </link>

  <link name="link1">
    <visual>
      <origin xyz="0.5 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.86 0.10 0.10"/>
      </geometry>
      <material name="link_blue">
        <color rgba="0.1 0.35 0.9 1"/>
      </material>
    </visual>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.075"/>
      </geometry>
      <material name="joint_dark">
        <color rgba="0.04 0.04 0.04 1"/>
      </material>
    </visual>
    <visual>
      <origin xyz="1.0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.075"/>
      </geometry>
      <material name="joint_dark">
        <color rgba="0.04 0.04 0.04 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0.5 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.86 0.10 0.10"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0.5 0 0" rpy="0 0 0"/>
      <mass value="0.8"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.07" iyz="0" izz="0.07"/>
    </inertial>
  </link>

  <link name="link2">
    <visual>
      <origin xyz="0.4 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.66 0.095 0.095"/>
      </geometry>
      <material name="link_orange">
        <color rgba="0.95 0.45 0.08 1"/>
      </material>
    </visual>
    <visual>
      <origin xyz="0.8 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.07"/>
      </geometry>
      <material name="wrist_dark">
        <color rgba="0.08 0.08 0.08 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0.4 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.66 0.095 0.095"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0.4 0 0" rpy="0 0 0"/>
      <mass value="0.6"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.04" iyz="0" izz="0.04"/>
    </inertial>
  </link>

  <link name="end_effector">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.055"/>
      </geometry>
      <material name="ee_red">
        <color rgba="0.9 0.05 0.05 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.055"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.1"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <joint name="joint1" type="revolute">
    <parent link="base"/>
    <child link="link1"/>
    <origin xyz="0 0 0.40" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14159" upper="3.14159" effort="20" velocity="5"/>
  </joint>

  <joint name="joint2" type="revolute">
    <parent link="link1"/>
    <child link="link2"/>
    <origin xyz="1.0 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14159" upper="3.14159" effort="20" velocity="5"/>
  </joint>

  <joint name="ee_fixed" type="fixed">
    <parent link="link2"/>
    <child link="end_effector"/>
    <origin xyz="0.8 0 0" rpy="0 0 0"/>
  </joint>
</robot>
